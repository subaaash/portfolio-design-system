{
  "name": "portfolio-design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20.19.0" },
  "scripts": {
    "tokens:check": "node scripts/tokens.mjs --check",
    "tokens:build": "node scripts/tokens.mjs",
    "dev": "npm run tokens:build && vite",
