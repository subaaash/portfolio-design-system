    "preview": "vite preview",
    "storybook": "npm run tokens:build && storybook dev -p 6006",
    "build-storybook": "npm run tokens:build && storybook build"
  },
  "dependencies": {
    "@fontsource/inter": "5.2.8",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.6.8",
    "storybook": "10.6.8",
    "vite": "6.4.6"
  }
}
